(define (domain block-world)
  (:requirements :strips)
  (:types block location robot)
  (:predicates (at ?x - block ?y - location)
               (clear ?x - block)
               (clear_loc ?x - location)
               (in_hand ?x - block ?y - robot)
               (on ?x - block ?y - block))

  (:derived (handempty ?x - robot)
            (forall (?y - block)
                    (not (in_hand ?y ?x))))

  (:action pick-up
           :parameters (?x - block ?y - location ?z - robot)
           :precondition (and (clear ?x)
                              (at ?x ?y)
                              (handempty ?z))
           :effect (and (not (clear ?x))
                        (not (at ?x ?y))
                        (in_hand ?x ?z)
                        (clear_loc ?y))
           )

  (:action put-down
           :parameters (?x - block ?y - location ?z - robot)
           :precondition (and (clear_loc ?y)
                              (in_hand ?x ?z))
           :effect (and (clear ?x)
                        (at ?x ?y)
                        (not (in_hand ?x ?z))
                        (not (clear_loc ?y)))
           )

  (:action stack
           :parameters (?x - block ?y - block ?z - robot)
           :precondition (and (clear ?y)
                              (in_hand ?x ?z))
           :effect (and (not (clear ?y))
                        (not (in_hand ?x ?z))
                        (clear ?x)
                        (on ?x ?y))
           )

  (:action unstack
           :parameters (?x - block ?y - block ?z - robot)
           :precondition (and (on ?x ?y)
                              (clear ?x)
                              (handempty ?z))
           :effect (and (clear ?y)
                        (in_hand ?x ?z)
                        (not (clear ?x))
                        (not (on ?x ?y)))
           )
  )
