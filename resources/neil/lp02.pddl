(define (problem sussman)
  (:domain blocksworld)
  (:objects a b c d e f g h i j - block
            l0 l1 l2 - location
            )
  (:init (= (position a) l0)
         (= (position b) a)
         (= (position c) l1)
         (= (position d) e)
         (= (position e) g)
         (= (position f) d)
         (= (position g) b)
         (= (position h) f)
         (= (position i) h)
         (= (position j) i)
         )
  (:goal (and (= (position a) b)
              (= (position b) c)
              (= (position c) d)
              (= (position d) e)
              (= (position e) f)
              (= (position f) g)
              (= (position g) h)
              (= (position h) i)
              (= (position i) j)
              ;; (= (position j) d)
              )
         )
  )
