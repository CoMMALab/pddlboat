(define (problem sussman)
  (:domain blocksworld)
  (:objects a b c d e f g h - block
            l0 l1 l2 l3 l4 - location
            )
  (:init (= (position a) l0)
         (= (position b) f)
         (= (position c) l4)
         (= (position d) b)
         (= (position e) l2)
         (= (position f) g)
         (= (position g) l1)
         (= (position h) l3)
         )
  (:goal (and (= (position a) d)
              (= (position b) e)
              (= (position c) b)
              (= (position d) h)
              (= (position e) g)
              (= (position f) a)
              (= (position g) f)
              )
         )
  )
